{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DirtyBeann/agency-harness/contracts/skeptic_verdict.schema.json",
  "title": "SkepticVerdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verdict",
    "rounds_used"
  ],
  "properties": {
    "schema": {
      "const": "SkepticVerdict/v1"
    },
    "verdict": {
      "enum": [
        "PASS",
        "NOT_READY",
        "BLOCKED"
      ]
    },
    "rounds_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "maxItems": 32
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "maxItems": 32
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "maxItems": 32
    },
    "incomplete": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "maxItems": 32
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "maxItems": 32
    },
    "evidence_index": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "maxItems": 32
    },
    "next": {
      "type": "string",
      "maxLength": 240
    },
    "artifact_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^(file://|https://|[A-Za-z]:\\\\|\\\\\\\\|/|\\./|ledger/|artifacts/|contracts/|docs/)"
      },
      "maxItems": 16
    }
  },
  "allOf": [
    {
      "description": "Reject secret-shaped substrings in free-text",
      "properties": {
        "next": {
          "not": {
            "pattern": "(?i)(sk_live_|sk_test_|rk_live_|whsec_|ghp_|github_pat_|gho_|xox[baprs]-|BEGIN [A-Z ]*PRIVATE KEY|eyJ[A-Za-z0-9_-]{20,}|SENTRY_ACCESS_TOKEN|API_KEY\\s*=|password\\s*=|Bearer\\s+[A-Za-z0-9._\\-]{20,})"
          }
        }
      }
    },
    {
      "description": "Reject provider key shapes in free-text: OpenAI sk- (incl. sk-proj- and sk-svcacct-), Anthropic sk-ant-, AWS AKIA/ASIA ids and secret_access_key assignments, Google AIza keys. sk- must sit at a word boundary so words like task-runner or risk- are not flagged.",
      "properties": {
        "next": {
          "not": {
            "pattern": "(\\bsk-ant-[A-Za-z0-9_-]{10,}|\\bsk-[A-Za-z0-9_-]{20,}|(AKIA|ASIA)[A-Z0-9]{16}|\\bAIza[0-9A-Za-z_-]{35}|(aws_secret_access_key|secret_access_key|AWS_SECRET_ACCESS_KEY|SECRET_ACCESS_KEY)\\s*[=:]\\s*['\\\"]?[A-Za-z0-9/+=]{35,})"
          }
        }
      }
    },
    {
      "description": "PASS verdicts must carry evidence: non-empty evidence_index or artifact_paths, and no open unverified/incomplete/failures/violations (failure fixture 01)",
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "evidence_index"
            ],
            "properties": {
              "evidence_index": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "artifact_paths"
            ],
            "properties": {
              "artifact_paths": {
                "minItems": 1
              }
            }
          }
        ],
        "properties": {
          "unverified": {
            "maxItems": 0
          },
          "incomplete": {
            "maxItems": 0
          },
          "failures": {
            "maxItems": 0
          },
          "violations": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "description": "SkepticVerdict/v1. Evidence labels only. No log dumps or secret material."
}
